ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DEBUG=
# Required when DJANGO_DEBUG is not true; use the same secret for all workers.
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=project.settings

# Optional: additional directory of static files to collect
STATIC_SHARE=

# Optional: directory for comic originals (defaults to ./media)
MEDIA_ROOT=
MEDIA_URL=/media/

